{
  "flows": {
    "F01": [
      "Maintenance submission",
      "MaintenanceSubmission",
      "Data clerk -> P1",
      "A submitted dataset and its input location; never silently round invalid quantities."
    ],
    "F02": [
      "Maintenance outcome",
      "MaintenanceOutcome",
      "P1 -> Data clerk",
      "Accepted record counts or located errors. Proposed import policy: validate the entire submission before committing it."
    ],
    "F03": [
      "Planning request",
      "PlanningRequest",
      "Planner -> P2 / P2.1",
      "Selected task IDs, baseline date and rule version; reject an empty selection."
    ],
    "F04": [
      "Query and export request",
      "QueryRequest",
      "Planner -> P3",
      "A saved batch, optional filters, and VIEW or CSV output mode."
    ],
    "F05": [
      "Plan response",
      "PlanResponse",
      "P3 -> Planner",
      "Saved results, history views, export data, or located errors. Never label a failed save as successful."
    ],
    "F06": [
      "Accepted source records",
      "SourceSet",
      "P1 -> D1",
      "Validated source updates. Only maintenance changes source data."
    ],
    "F07": [
      "Existing source records",
      "SourceSet",
      "D1 -> P1",
      "Current records for uniqueness, reference and update checks."
    ],
    "F08": [
      "Planning source records",
      "SourceSet",
      "D1 -> P2 / P2.1",
      "One consistent read of selected tasks and their reachable materials, BOM and stock."
    ],
    "F09": [
      "Calculation outcome",
      "CalculationOutcome",
      "P2 / P2.1 / P2.3 -> P3",
      "Tagged union: INVALID with errors, or VALID with a complete calculated batch. F09.invalid and F09.valid denote its alternatives."
    ],
    "F10": [
      "Immutable batch record",
      "BatchRecord",
      "P3 -> D2",
      "Successful results plus complete input and rule snapshots, written atomically. No actual inventory update."
    ],
    "F11": [
      "Historical batch records",
      "List[BatchRecord]",
      "D2 -> P3",
      "Saved snapshots and matching results used for history, trace and CSV."
    ],
    "F12": [
      "Validated planning context",
      "Context",
      "P2.1 -> P2.2 / P2.2.1",
      "Valid selected data, deterministic task order, initial availability and rule snapshot."
    ],
    "F13": [
      "Net requirements bundle",
      "NetBundle",
      "P2.2 / P2.2.3 -> P2.3",
      "Complete context, net manufacturing requirements, dated BUY shortages, demand provenance and allocation ledger."
    ],
    "F14": [
      "Allocation candidates",
      "CandidateEnvelope",
      "P2.2.1 -> P2.2.2",
      "Context plus ordered, merged task-material-date demand buckets with every contributing source."
    ],
    "F15": [
      "Working stock updates",
      "List[Balance]",
      "P2.2.2 -> D3",
      "Replacement batch balances after allocation; nonnegative and isolated from actual stock."
    ],
    "F16": [
      "Working stock balances",
      "List[Balance]",
      "D3 -> P2.2.2",
      "Current batch balances before allocation, indexed by material."
    ],
    "F17": [
      "Initial working balances",
      "List[Balance]",
      "P2.2.1 -> D3",
      "Available stock initialized once per batch from on_hand minus reserved."
    ],
    "F18": [
      "Netted demand records",
      "NettedEnvelope",
      "P2.2.2 -> P2.2.3",
      "Context, demands with allocation and residual quantities, and their allocation records."
    ],
    "F19": [
      "Child demand records",
      "List[Demand]",
      "P2.2.3 -> P2.2.1",
      "New child requests from positive MAKE residuals; child date equals parent planned start."
    ]
  },
  "stores": [
    [
      "D1",
      "Source data",
      "SourceSet",
      "P1 writes; P1 and P2.1 read",
      "Material, BOM, task and inventory data. No planning process writes to this store."
    ],
    [
      "D2",
      "Saved plan batches",
      "List[BatchRecord]",
      "P3 writes and reads",
      "All-or-nothing saved input snapshots and output history."
    ],
    [
      "D3",
      "Working stock",
      "List[Balance]",
      "P2.2.1 initializes; P2.2.2 reads and updates",
      "Transient, private to one calculation; introduced inside P2.2, not a new parent boundary."
    ]
  ],
